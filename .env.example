# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Anthropic API key for the website concierge (server-side only, never sent to the browser).
# Without it, the chat politely points visitors to phone/text/email.
ANTHROPIC_API_KEY=

# Where quote-form and chat leads are sent (Zapier, Make, GoHighLevel, Slack webhook, or any JSON POST endpoint).
# Without it, leads are printed to the server log.
LEAD_WEBHOOK_URL=

# "CALL NOW" alerts for your VA when someone gets an instant quote but doesn't book
# (e.g. a Zapier/Make webhook that texts the VA, or a Slack channel webhook).
# Falls back to LEAD_WEBHOOK_URL if empty.
VA_ALERT_WEBHOOK_URL=

# Secret used to encrypt the "resume your quote" links texted to customers.
# Any long random string (e.g. run: openssl rand -hex 32).
QUOTE_TOKEN_SECRET=

# Live site address, used for canonical URLs, the sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://scrubhubcleansllc.com
